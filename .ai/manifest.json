      "skill": "mbg-design-regression",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "debug_placement": {
      "summary": "Inspect placement: matching, symmetry, overlap, pin access, reserved zones, congestion.",
