      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": false
      }
    },
    "mbg-review-ai-experiment": {
      "summary": "Review an AI experiment record for reproducibility and evidence.",
      "agent": "plan",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": false
      }
    },
    "mbg-review-extension": {
      "summary": "Review an agent extension against the project authoring and safety rules.",
      "agent": "plan",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": false
      }
    },
    "mbg-new-skill": {
      "summary": "Scaffold a new canonical skill under .ai/skills and resync all platforms.",
      "agent": "build",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": false
      }
    },
    "mbg-new-command": {
      "summary": "Scaffold a new canonical workflow under .ai/workflows and resync all platforms.",
      "agent": "build",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": false
      }
    },
    "mbg-new-tool": {
      "summary": "Create a safe OpenCode custom tool using the project authoring standard.",
      "agent": "build",
      "platforms": {
        "opencode": true,
        "claude": false,
        "codex": false
      }
    }
  },
  "index_targets": {
    "framework_utils": {
      "root": "src/mbg",
      "glob": "*.py"
    },
    "placement_modules": {
      "root": "src/mbg",
      "match": [
        "placement",
        "placement_engine",
        "power"
      ]
    },
    "routing_modules": {
      "root": "src/mbg",
      "match": [
        "routing",
        "router",
        "connectivity"
      ]
    },
    "pdk_modules": {
      "root": "src/mbg",
      "match": [
        "pdk_rules",
        "pdk_devices"
      ]
    },
    "spice_modules": {
      "root": "src/mbg",
      "match": [
        "spice_parser",
        "simulation"
      ]
    },
    "verification_modules": {
      "root": "src/mbg",
      "match": [
        "checks",
        "connectivity"
      ]
    },
    "tests": {
      "root": "tests",
      "glob": "test_*.py"
    },
    "generated_designs": {
      "root": "AI-Generated-Design-Result",
      "dirs_only": true
    }
  }
}
