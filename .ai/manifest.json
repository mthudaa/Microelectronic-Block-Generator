      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "debug_routing": {
      "summary": "Trace nets, inspect vias and metal usage, and detect shorts, opens and route conflicts.",
      "class": "READ-ONLY",
      "skill": "mbg-routing-debug",
      "entry_point": "mbg.router",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "generate_views": {
      "summary": "Emit LEF, Liberty, Verilog and a views manifest alongside the GDS for every module.",
      "class": "GENERATING",
      "skill": "mbg-spice-to-gds",
      "entry_point": "mbg.outputs.write_all",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "inspect_generated_designs": {
      "summary": "Read previous results in AI-Generated-Design-Result as evidence and regression baselines.",
      "class": "READ-ONLY",
      "skill": "mbg-design-regression",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "inspect_repository": {
      "summary": "Map the repository, trace the active execution path, and separate active from legacy code.",
      "class": "READ-ONLY",
      "skill": "mbg-repo-analysis",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "install_agents": {
      "summary": "Register the agent integrations for OpenCode, Claude Code and Codex.",
      "class": "MUTATING",
      "skill": "mbg-setup",
      "command": "./scripts/install_agents.sh",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "integrate_modules": {
      "summary": "Collect generated modules into a LibreLane macro integration with info.yaml and lvs_config.json.",
      "class": "GENERATING",
      "skill": "mbg-spice-to-gds",
      "command": "python3 scripts/integrate_modules.py --librelane",
      "entry_point": "mbg.integrate.integrate",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "run_drc": {
      "summary": "Run Magic DRC on a GDS and interpret the error tiles.",
      "class": "GENERATING",
      "skill": "mbg-ic-verify",
      "entry_point": "mbg.checks.run_drc",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "run_lvs": {
      "summary": "Run netgen LVS against the source netlist and interpret topology, property and pin results.",
      "class": "GENERATING",
      "skill": "mbg-ic-verify",
      "entry_point": "mbg.checks.run_lvs",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "run_pex": {
      "summary": "Run parasitic extraction and produce a post-layout netlist.",
      "class": "GENERATING",
      "skill": "mbg-ic-verify",
      "entry_point": "mbg.checks.run_pex",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "run_simulation": {
      "summary": "Run ngspice on a netlist and parse the raw output into usable data.",
      "class": "GENERATING",
      "skill": "mbg-spice-sim",
      "entry_point": "mbg.simulation.run_spice",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "setup_environment": {
      "summary": "Create or repair the Python environment and report the toolchain and PDK.",
      "class": "MUTATING",
      "skill": "mbg-setup",
      "command": "./scripts/setup_env.sh",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "simulate_analyses": {
      "summary": "Operating point, DC, AC, transient, Monte Carlo and FFT via mbg.analysis.Testbench.",
      "class": "GENERATING",
      "skill": "mbg-spice-sim",
      "entry_point": "mbg.analysis.Testbench",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "spice_to_gds": {
      "summary": "Generate a DRC-clean GDSII layout from a SPICE subcircuit via gLayout.",
      "class": "GENERATING",
      "skill": "mbg-spice-to-gds",
      "entry_point": "mbg.pipeline.spice_to_gds_with_checks",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "sync_agent_metadata": {
      "summary": "Rescan the repository, refresh the project index and regenerate all platform adapters.",
      "class": "GENERATING",
      "command": "python3 scripts/sync_agent_tools.py",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "verify_connectivity": {
      "summary": "Compare physical connectivity against the SPICE netlist before external signoff.",
      "class": "READ-ONLY",
      "skill": "mbg-routing-debug",
      "entry_point": "mbg.connectivity.verify",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    }
  },
  "workflows": {
    "mbg-full-automate": {
      "summary": "Full automatic analog IC design flow, specification to tapeout-ready layout.",
