{
  "$comment": "SOURCE OF TRUTH. Canonical agent-integration manifest for the Microelectronic Block Generator. Edited by hand; consumed by scripts/sync_agent_tools.py to generate the OpenCode, Claude Code and Codex adapters. JSON is used because it is the only zero-dependency format available on every interpreter in this repository (the root .venv lacks PyYAML, the chipathon .venv lacks tomllib).",
  "schema_version": 1,
  "project": {
    "name": "Microelectronic Block Generator",
    "slug": "mbg",
    "extension_prefix": "mbg-",
    "framework": "gLayout + gdsfactory",
    "pdk": "gf180mcuD",
    "core_utilities": "src/mbg",
    "generated_designs": "AI-Generated-Design-Result",
    "shared_instructions": "AGENTS.md",
    "package": "mbg"
  },
  "platforms": {
    "opencode": {
      "version_tested": "1.18.18",
      "skills_dir": ".opencode/skills",
      "skill_file": "SKILL.md",
      "commands_dir": ".opencode/commands",
      "agents_dir": ".opencode/agents",
      "instructions_file": "AGENTS.md",
      "supports": [
        "skills",
        "commands",
        "agents",
        "code_tools",
        "repo_permissions"
      ],
      "generated": [
        "skills",
        "commands"
      ]
    },
    "claude": {
      "version_tested": "2.1.235",
      "skills_dir": ".claude/skills",
      "skill_file": "SKILL.md",
      "commands_dir": ".claude/commands",
      "agents_dir": ".claude/agents",
      "instructions_file": "CLAUDE.md",
      "settings_file": ".claude/settings.json",
      "supports": [
        "skills",
        "commands",
        "agents",
        "repo_permissions",
        "hooks",
        "mcp"
      ],
      "generated": [
        "skills",
        "commands",
        "instructions"
      ]
    },
    "codex": {
      "version_tested": "0.148.0",
      "plugin_root": "plugins/mbg-analog",
      "plugin_manifest": "plugins/mbg-analog/.codex-plugin/plugin.json",
      "skills_dir": "plugins/mbg-analog/skills",
      "skill_file": "SKILL.md",
      "marketplace_file": ".agents/plugins/marketplace.json",
      "marketplace_name": "mbg-local",
      "instructions_file": "AGENTS.md",
      "supports": [
        "skills",
        "repo_plugin",
        "marketplace",
        "mcp"
      ],
      "unsupported": [
        "repo_scoped_commands",
        "repo_scoped_agents",
        "repo_scoped_config"
      ],
      "generated": [
        "skills",
        "plugin_manifest",
        "marketplace"
      ]
    }
  },
  "capabilities": {
    "analyze_spice": {
      "summary": "Parse SPICE subcircuits, enumerate devices, nets and terminals, and trace connectivity.",
      "class": "READ-ONLY",
      "skill": "mbg-repo-analysis",
      "entry_point": "mbg.spice_parser.parse_netlist_with_pdk",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "audit_ai_experiment": {
      "summary": "Audit an AI experiment record for reproducibility, bounded refinement and evidence.",
      "class": "READ-ONLY",
      "skill": "mbg-ai-experiment-audit",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "author_extension": {
      "summary": "Create or review agent skills, commands and tools using the project authoring standard.",
      "class": "GENERATING",
      "skill": "mbg-extension-authoring",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "compare_layout_results": {
      "summary": "Compare a new layout run against a preserved baseline without overwriting it.",
