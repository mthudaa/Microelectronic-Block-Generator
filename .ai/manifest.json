{
  "$comment": "Canonical public agent metadata. Regenerate adapters from these reviewed sources.",
  "schema_version": 1,
  "project": {
    "name": "Microelectronic Block Generator",
    "slug": "mbg",
    "extension_prefix": "mbg-",
    "framework": "gLayout + gdsfactory",
    "pdk": "gf180mcuD",
    "core_utilities": "src/mbg",
    "generated_designs": "outputs",
    "shared_instructions": "AGENTS.md",
    "package": "mbg"
  },
  "platforms": {
    "opencode": {
      "skills_dir": ".opencode/skills",
      "skill_file": "SKILL.md",
      "commands_dir": ".opencode/commands",
      "agents_dir": ".opencode/agents",
      "instructions_file": "AGENTS.md",
      "supports": [
        "skills",
        "commands",
        "agents",
        "code_tools",
        "repo_permissions",
        "mcp"
      ],
      "generated": [
        "skills",
        "commands"
      ]
    },
    "claude": {
      "skills_dir": ".claude/skills",
      "skill_file": "SKILL.md",
      "commands_dir": ".claude/commands",
      "agents_dir": ".claude/agents",
      "instructions_file": "CLAUDE.md",
      "settings_file": ".claude/settings.json",
      "supports": [
        "skills",
        "commands",
        "agents",
        "repo_permissions",
        "hooks",
        "mcp"
      ],
      "generated": [
        "skills",
        "commands",
        "instructions"
      ]
    },
    "codex": {
      "plugin_root": "plugins/mbg-analog",
      "plugin_manifest": "plugins/mbg-analog/.codex-plugin/plugin.json",
      "skills_dir": "plugins/mbg-analog/skills",
      "skill_file": "SKILL.md",
      "marketplace_file": ".agents/plugins/marketplace.json",
      "marketplace_name": "mbg-local",
      "instructions_file": "AGENTS.md",
      "supports": [
        "skills",
        "repo_plugin",
        "marketplace",
        "mcp"
      ],
      "unsupported": [
        "repo_scoped_commands",
        "repo_scoped_agents",
        "repo_scoped_config"
      ],
      "generated": [
        "skills",
        "plugin_manifest",
        "marketplace"
      ]
    },
    "agents": {
      "$comment": "Agent Skills standard tree for compatible CLI and MCP clients.",
      "skills_dir": ".agents/skills",
      "skill_file": "SKILL.md",
      "instructions_file": "AGENTS.md",
      "generated": [
        "skills"
      ]
    }
  },
  "capabilities": {
    "agent_cli": {
      "summary": "Use the public CLI and MCP tools for checked layout work.",
      "class": "GENERATING",
      "skill": "mbg-agent-interface",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "setup_environment": {
      "summary": "Install and inspect the public Python, PDK and EDA environment.",
      "class": "MUTATING",
      "skill": "mbg-setup",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "spice_to_gds": {
      "summary": "Generate a checked layout from an explicit SPICE input.",
      "class": "GENERATING",
      "skill": "mbg-spice-to-gds",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "run_drc": {
      "summary": "Run DRC, LVS and parasitic extraction on a selected layout.",
      "class": "GENERATING",
      "skill": "mbg-ic-verify",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "run_simulation": {
      "summary": "Simulate an explicit circuit and report measured results.",
      "class": "GENERATING",
      "skill": "mbg-spice-sim",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "debug_placement": {
      "summary": "Inspect device locations and layout access without changing connectivity.",
      "class": "READ-ONLY",
      "skill": "mbg-placement-debug",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "debug_routing": {
      "summary": "Inspect route failures, opens and shorts in a selected run.",
      "class": "READ-ONLY",
      "skill": "mbg-routing-debug",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "ordinary_macro": {
      "summary": "Prepare an ordinary guard-ring macro through the checked layout tool.",
      "class": "GENERATING",
      "skill": "mbg-ordinary-macro",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    },
    "inspect_repository": {
      "summary": "Find the public entry points and relevant source modules.",
      "class": "READ-ONLY",
      "skill": "mbg-repo-analysis",
      "platforms": {
        "opencode": true,
        "claude": true,
        "codex": true
      }
    }
  },
  "workflows": {
    "mbg-install": {
      "summary": "Install the public MBG environment.",
      "platforms": {
        "opencode": true,
        "claude": true
      }
    },
    "mbg-layout": {
      "summary": "Generate a checked layout from an explicit input.",
      "platforms": {
        "opencode": true,
        "claude": true
      }
    },
    "mbg-verify": {
      "summary": "Verify a selected layout against explicit circuit inputs.",
      "platforms": {
        "opencode": true,
        "claude": true
      }
    }
  },
  "index_targets": {
    "public_core": {
      "root": "src/mbg",
      "match": [
        "analysis",
        "checks",
        "config",
        "connectivity",
        "design_context",
        "drc",
        "layout_view",
        "measure",
        "netlist_check",
        "outputs",
        "passives",
        "pdk_profile",
        "pdk_rules",
        "pipeline",
        "placement_engine",
        "power",
        "router",
        "simulation",
        "specs",
        "spice_parser",
        "utils",
        "macro",
        "macro_guardring",
        "output_paths"
      ]
    },
    "pdk_profiles": {
      "root": "src/mbg/pdks",
      "glob": "*.json"
    }
  },
  "mcp": {
    "$comment": "One stdio MCP server for every harness: `scripts/mbg mcp` (zero dependencies; each call runs the mbg CLI). Project-scoped client configs are generated from this block. OpenCode's entry lives in the hand-maintained opencode.jsonc.",
    "server_name": "mbg",
    "command": "scripts/mbg",
    "args": [
      "mcp"
    ],
    "tool_timeout_sec": 1800,
    "configs": {
      "claude": ".mcp.json",
      "codex": ".codex/config.toml",
      "cursor": ".cursor/mcp.json",
      "gemini": ".gemini/settings.json"
    }
  },
  "release": {
    "tier": "basic-intermediate",
    "canonical_skills": [
      "mbg-agent-interface",
      "mbg-ic-verify",
      "mbg-ordinary-macro",
      "mbg-placement-debug",
      "mbg-repo-analysis",
      "mbg-routing-debug",
      "mbg-setup",
      "mbg-spice-sim",
      "mbg-spice-to-gds"
    ]
  }
}
