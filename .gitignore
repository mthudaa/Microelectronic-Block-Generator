

# Ignore all spice simulation results
*.raw

# Ignore all log files
*.log

# Ignore local environment variables file
.env

# Ignore all temp files
temp/  

# Ignore all .DS_Store files
.DS_Store

# Ignore all .pytest_cache files
.pytest_cache/
__pycache__/

# Ignore all .ipynb_checkpoints files
.ipynb_checkpoints
.jupyter_ystore.db
.jupyter/
.Trash-1000/


# Ignore all .net files generated by the CI script
*.net

designs/simulations/

# devcontainer
.devcontainer

tools/

*.lyrdb

.cursor/
context/

*.gds.backup

# Keep project-level OpenCode tools under version control
!.opencode/
!.opencode/tools/
!.opencode/tools/**

# The negations above re-include EVERYTHING under .opencode/tools/, which
# overrode the __pycache__ rule and caused compiled .pyc files to be committed.
# Re-exclude build artifacts without losing the source negation.
.opencode/tools/**/__pycache__/
.opencode/tools/**/*.pyc

# Claude Code: settings.json is shared and committed; the .local override is personal.
.claude/settings.local.json
# Regression run artifacts
outputs/

# tools
AGENTS.md
CLAUDE.md

# ── Python environments ─────────────────────────────────────────────
# A virtual environment is machine-specific: it hard-codes absolute paths
# and an interpreter ABI. 17k files of one were once committed here, which
# is why a fresh clone inherited dangling links to another machine's
# Python 3.10. Dependencies are specified, never vendored.
.venv/
venv/
env/
ENV/
.python-version

# Build metadata regenerated by every `pip install -e .`
*.egg-info/
src/*.egg-info/

# ── MBG local EDA toolchain ─────────────────────────────────────────
# Built under $MBG_TOOLS_ROOT (default ~/.local/mbg-tools); never in-tree.
/tools/
.mbg-env.sh
