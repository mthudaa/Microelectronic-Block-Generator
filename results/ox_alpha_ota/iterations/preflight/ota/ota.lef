VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO ota
  CLASS BLOCK ;
  FOREIGN ota ;
  ORIGIN 25.260 3.940 ;
  SIZE 50.540 BY 59.120 ;
  PIN IBIAS
    ANTENNAGATEAREA 68.000000 ;
    ANTENNADIFFAREA 1.200000 ;
