        RECT -21.810 0.210 21.810 50.560 ;
      LAYER Metal2 ;
        RECT -22.170 21.130 22.190 50.560 ;
        RECT -22.170 20.250 -4.470 21.130 ;
        RECT -3.590 20.250 4.390 21.130 ;
        RECT 5.270 20.250 22.190 21.130 ;
        RECT -22.170 0.210 22.190 20.250 ;
      LAYER Metal3 ;
        RECT -25.260 53.600 -12.900 54.460 ;
        RECT -0.340 53.600 25.280 54.460 ;
        RECT -25.260 6.400 25.280 53.600 ;
        RECT -25.260 2.000 -2.980 6.400 ;
        RECT -2.100 2.000 25.280 6.400 ;
        RECT -25.260 -3.220 25.280 2.000 ;
      LAYER Metal4 ;
        RECT -25.230 51.280 25.250 54.430 ;
        RECT -25.230 32.600 -0.940 51.280 ;
        RECT -0.060 32.600 25.250 51.280 ;
        RECT -25.230 11.500 25.250 32.600 ;
