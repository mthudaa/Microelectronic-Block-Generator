    PORT
      LAYER Metal4 ;
        RECT -10.600 -2.800 -10.040 12.220 ;
    END
  END VSS
  PIN VDD
    USE POWER ;
    PORT
      LAYER Metal3 ;
        RECT 0.020 42.680 6.880 43.240 ;
    END
  END VDD
  OBS
      LAYER Nwell ;
        RECT -17.580 0.000 17.580 40.270 ;
      LAYER Metal1 ;
        RECT -17.350 0.210 18.490 40.060 ;
      LAYER Metal2 ;
        RECT -17.710 20.130 18.490 40.060 ;
        RECT -17.710 19.250 -9.580 20.130 ;
        RECT -8.700 19.250 -4.020 20.130 ;
        RECT -3.140 19.250 18.490 20.130 ;
        RECT -17.710 0.210 18.490 19.250 ;
      LAYER Metal3 ;
        RECT -20.800 42.380 -0.280 43.240 ;
        RECT 7.180 42.380 20.560 43.240 ;
        RECT -20.800 -3.220 20.560 42.380 ;
      LAYER Metal4 ;
        RECT -20.770 41.080 20.530 43.240 ;
        RECT -20.770 33.940 10.660 41.080 ;
        RECT -20.770 32.920 7.600 33.940 ;
        RECT -20.770 12.520 -8.720 32.920 ;
        RECT -20.770 -3.100 -10.900 12.520 ;
        RECT -9.740 0.980 -8.720 12.520 ;
        RECT -7.840 22.400 7.600 32.920 ;
        RECT 8.480 27.500 10.660 33.940 ;
        RECT 11.540 27.500 20.530 41.080 ;
        RECT 8.480 22.400 20.530 27.500 ;
        RECT -7.840 0.980 20.530 22.400 ;
        RECT -9.740 -3.100 20.530 0.980 ;
        RECT -20.770 -3.220 20.530 -3.100 ;
      LAYER Metal5 ;
