    ANTENNADIFFAREA 3.960000 ;
    PORT
      LAYER Metal4 ;
        RECT 7.900 22.700 8.180 33.640 ;
    END
  END OUTP
  PIN CLK
    ANTENNAGATEAREA 5.900000 ;
    PORT
      LAYER Metal4 ;
        RECT -8.420 1.280 -8.140 32.620 ;
    END
  END CLK
  PIN INN
    ANTENNAGATEAREA 2.100000 ;
    PORT
      LAYER Metal2 ;
        RECT -9.280 19.550 -9.000 19.830 ;
    END
  END INN
  PIN INP
    ANTENNAGATEAREA 2.100000 ;
    PORT
      LAYER Metal2 ;
        RECT -3.720 19.550 -3.440 19.830 ;
    END
  END INP
  PIN VSS
