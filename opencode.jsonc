{
"$schema": "https://opencode.ai/config.json",

"permission": {
"read": {
"*": "allow",
"*.env": "deny",
"*.env.*": "deny",
"*.env.example": "allow"
},


"glob": "allow",
"grep": "allow",

"edit": "ask",

"skill": {
  "*": "ask",
  "mbg-*": "allow"
},

"external_directory": "ask",
"doom_loop": "ask",

"bash": {
  "*": "ask",

  "pwd": "allow",
  "ls": "allow",
  "ls *": "allow",
  "find *": "allow",
  "grep *": "allow",

  "git status": "allow",
  "git status *": "allow",
  "git diff": "allow",
  "git diff *": "allow",
  "git log": "allow",
  "git log *": "allow",
  "git branch": "allow",
  "git branch *": "allow",

  "docker ps": "allow",
  "docker ps *": "allow",
  "docker logs *": "ask",
  "docker exec *": "ask",

  "git add *": "ask",
  "git commit *": "ask",

  "git push": "deny",
  "git push *": "deny",
  "rm -rf": "deny",
  "rm -rf *": "deny"
},

"mbg-validate-ai-experiment": "allow",
    "mbg-validate-extension": "allow"


}
}
