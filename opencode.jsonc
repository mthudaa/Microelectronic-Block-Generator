{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "mbg": {
      "type": "local",
      "command": [
        "scripts/mbg",
        "mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "scripts/mbg *": "allow",
      "*": "ask"
    }
  }
}
