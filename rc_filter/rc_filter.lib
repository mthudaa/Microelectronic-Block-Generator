/*
 * Liberty abstract for the analog macro `rc_filter`.
 * Generated by mbg.outputs.
 *
 * This is a HARD MACRO abstract, not a characterised cell: it carries
 * pin directions, supply pins and a nominal input capacitance so a
 * synthesiser and floorplanner can work around the block. It contains
 * no timing arcs, because none were characterised.
 */
library (rc_filter_lib) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, pf);
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  default_max_transition : 1.0;

  voltage_map (VDD, 3.3);
  voltage_map (VSS, 0.0);

  operating_conditions (typical) {
    process : 1.0;
    temperature : 25.0;
    voltage : 3.3;
    tree_type : balanced_tree;
  }
  default_operating_conditions : typical;

  cell (rc_filter) {
    is_macro_cell : true;
    dont_touch : true;
    dont_use : true;
    interface_timing : true;

    pin(vin) {
      direction : inout;
      capacitance : 0.005;
    }
    pin(vout) {
      direction : inout;
      capacitance : 0.005;
    }
    pg_pin(vss) {
      voltage_name : VSS;
      pg_type : primary_ground;
    }
  }
}
